# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local API-key configuration (never commit secrets)
config/routes.json

# Android Kotlin build cache
android/.kotlin/

# Firebase CLI cache and local emulator state
.firebase/

# Firebase Functions
functions/node_modules/
functions/.runtimeconfig.json

# Private deployment configuration and local test dependencies
functions/.env*
!functions/.env.example
functions/.secret.local
security-tests/node_modules/
android/secrets.properties

# Local iOS configuration
/ios/Flutter/LocalSecrets.xcconfig
/ios/Runner/GoogleService-Info.plist
